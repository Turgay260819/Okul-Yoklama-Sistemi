rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol;
    }

    function isAdmin() {
      return getRole() == 'admin';
    }

    function isMudurYardimcisi() {
      return getRole() == 'mudur_yardimcisi';
    }

    function isOgretmen() {
      return getRole() == 'ogretmen';
    }

    function isOgrenci() {
      return getRole() == 'ogrenci';
    }

    function isYonetim() {
      return isAdmin() || isMudurYardimcisi();
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    // Salt-okunur idareci: yonetim ekranlarini gorur, hicbir sey yazamaz.
    function isIzleyici() {
      return getRole() == 'idareci_izleyici';
    }

    function isYonetimOkur() {
      return isYonetim() || isIzleyici();
    }

    function isYazabilir() {
      return isLoggedIn() && !isIzleyici();
    }

    // Istanbul'a gore bugunun tarihi (YYYY-AA-GG). Turkiye sabit UTC+3.
    function pad2(n) {
      return (n < 10 ? '0' : '') + string(n);
    }

    function tarihTR(t) {
      return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
    }

    function bugunTR() {
      return tarihTR(request.time + duration.value(3, 'h'));
    }

    // Bir onceki is gunu: Pazartesi -> Cuma (3 gun), Pazar -> Cuma (2),
    // digerleri -> dun (1). Tatiller ayrica atlanmaz. dayOfWeek: 1=Pzt..7=Paz.
    // portal-vekil-ders.js oncekiIsGunu() ile ayni mantik.
    function oncekiIsGunuTR() {
      let t = request.time + duration.value(3, 'h');
      let geri = t.dayOfWeek() == 1 ? 3 : (t.dayOfWeek() == 7 ? 2 : 1);
      return tarihTR(t - duration.value(geri * 24, 'h'));
    }

    // Ogretmenin vekil ders kaydi girebilecegi tarihler.
    function ogretmenTarihi(tarih) {
      return tarih == bugunTR() || tarih == oncekiIsGunuTR();
    }

    function kendiOgretmenDocu(teacherId) {
      return get(/databases/$(database)/documents/teachers/$(teacherId)).data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }

    match /students/{studentId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }

    match /teachers/{teacherId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }

    // Ogretmen telefonlari: teachers herkese acik oldugu icin ayri tutulur;
    // sadece idare okur (Genel Durum nobetci karti, Ayarlar > Ogretmenler).
    match /ogretmen_iletisim/{teacherId} {
      allow read: if isYonetimOkur();
      allow write: if isYonetim();
    }

    match /schedule/{scheduleId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }

    match /today_lessons/{lessonId} {
      allow read: if isLoggedIn();
      allow write: if isYazabilir();
    }

    match /attendance/{attendanceId} {
      allow read: if isLoggedIn();
      allow create: if isYazabilir();
      allow update: if isYonetim();
      allow delete: if isYonetim() || isOgretmen();
    }

    match /daily_summary/{summaryId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }

    match /late_entries/{entryId} {
      allow read: if isYonetimOkur();
      allow write: if isYazabilir();
    }

    match /notification_queue/{notifId} {
      allow read: if isYonetimOkur();
      allow write: if isYonetim();
    }

    match /dyk_courses/{courseId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }

    match /dyk_attendance/{attendanceId} {
      allow read: if isLoggedIn();
      allow create: if isYazabilir();
      allow update: if isYonetim();
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    match /system_logs/{logId} {
      allow read: if isYonetimOkur();
      allow write: if isLoggedIn();
    }

    match /attendance_archive/{docId} {
      allow read: if isYonetimOkur();
      allow write: if isAdmin();
    }
   
    match /disiplin_kayitlar/{docId} {
      allow read: if isYonetimOkur() || isOgretmen();
      allow create: if isYonetim() || isOgretmen();
      allow update, delete: if isYonetim();
    }
    match /aksakliklar/{docId} {
      allow read: if isYonetimOkur() ||
        (isOgretmen() && resource.data.ogretmen_uid == request.auth.uid);
      allow create: if (isYonetim() || isOgretmen()) &&
        request.resource.data.ogretmen_uid == request.auth.uid &&
        request.resource.data.durum == "acik";
      allow update, delete: if isYonetim();
    }
    match /aksaklik_ayarlar/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /izinler/{docId} {
      allow read: if isYonetimOkur() || isOgretmen();
      allow create: if isYonetim() || isOgretmen();
      allow update: if isYonetim() ||
        (isOgretmen() && resource.data.rehber_id != null &&
         get(/databases/$(database)/documents/teachers/$(resource.data.rehber_id)).data.uid == request.auth.uid);
      allow delete: if isYonetim();
    }
    match /disiplin_turleri/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /disiplin_ayarlar/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /gorevler/{doc} {
      allow read: if request.auth != null;
      allow write: if isYazabilir();
    }
    match /ogretmen_sirasi/{doc} {
      allow read: if request.auth != null;
      allow write: if isYazabilir();
    }
    match /oncelik_kuyrugu/{doc} {
      allow read: if request.auth != null;
      allow write: if isYazabilir();
    }
    match /takvim_kilidi/{doc} {
      allow read: if request.auth != null;
      allow write: if isYazabilir();
    }
    match /kazanim_dersler/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /kazanim_listesi/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /kazanim_takvim/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /kazanim_tatil/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /tatil_donemleri/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /ders_saatleri/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /ogretmen_devam/{docId} {
      allow read: if isYonetimOkur();
      allow write: if isYonetim();
    }
    match /nobet2_ayarlar/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /nobet_bildirim_alicilari/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /program_talebi_dersler/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /program_talebi_matris/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYazabilir();
    }
    match /program_talebi_ayarlar/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /program_talep_tanimlar/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /program_talep_sube_toplam/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /program_talep_matris/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYazabilir();
    }
    match /program_talep_ayarlar/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /anketler/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /anket_yanitlar/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYazabilir();
    }
    match /anket_sablonlar/{docId} {
      allow read: if isYonetimOkur();
      allow write: if isYonetim();
    }
    match /ogrenci_veriler/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYazabilir();
    }
    // Ogrenci yetenek kayitlari: ogrenciler erisemez. Ogretmen ve idare ekler
    // (giren_uid kendisi olmali); ogretmen sadece kendi kaydini siler. Ogretmenin
    // sinif kisiti (ders programi) istemcide, disiplin sistemindeki gibi.
    match /ogrenci_yetenekler/{docId} {
      allow read: if isYonetimOkur() || isOgretmen();
      allow create: if (isYonetim() || isOgretmen()) && request.resource.data.giren_uid == request.auth.uid;
      allow update: if isYonetim();
      allow delete: if isYonetim() || (isOgretmen() && resource.data.giren_uid == request.auth.uid);
    }
    match /geziler/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /gezi_katilim/{docId} {
      allow read: if isLoggedIn();
      allow create: if isYazabilir();
      allow update: if isYazabilir();
      allow delete: if isYonetim();
    }
    match /gezi_koltuk/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /gezi_katilacaklar/{docId} {
      allow read: if isLoggedIn();
      allow create: if isYazabilir();
      allow update: if isYazabilir();
      allow delete: if isYonetim() || (isYazabilir() && request.auth.uid == resource.data.kullanici_id);
    }
    match /bildirimler/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYazabilir();
    }
    match /ogretmen_rapor/{docId} {
      allow read: if request.auth != null;
      allow write: if isYazabilir();
    }
    match /ders_listesi/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /kura_torbalari/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /kura_oturumlari/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /kura_cekilisleri/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /nobet_gorulme/{docId} {
      allow read, write: if isLoggedIn();
    }
    // Vekil ders ucret kayitlari. Belge kimligi tarih_sinif_saat oldugu icin
    // bir sinif-saate tek kayit acilir; ogretmen update yapamadigi icin mevcut
    // kaydin ustune yazamaz (ilk giren alir). Kaydi SADECE ogretmen, kendi
    // adina, bugune veya bir onceki is gunune acar; idare kayit acamaz ve
    // degistiremez, hatali kaydi silebilir. Ogretmen ayni sure icinde kendi
    // kaydini silebilir.
    match /vekil_dersler/{docId} {
      allow read: if isLoggedIn();
      allow create: if isOgretmen() &&
         ogretmenTarihi(request.resource.data.tarih) &&
         request.resource.data.kaynak in ['sistem_onay', 'ogretmen'] &&
         request.resource.data.olusturan_uid == request.auth.uid &&
         kendiOgretmenDocu(request.resource.data.vekil_ogretmen_id);
      allow update: if false;
      allow delete: if isYonetim() ||
        (isOgretmen() &&
         ogretmenTarihi(resource.data.tarih) &&
         kendiOgretmenDocu(resource.data.vekil_ogretmen_id));
    }
    // Telefon bildirimi cihaz anahtarlari. Istemci sadece kendi uid'iyle yazar
    // ve kendi anahtarini siler; okumayi sadece sunucu (Admin SDK) yapar. Ayni
    // cihaza baska kullanici girerse anahtar yeni kullaniciya gecebilir.
    match /push_tokenlari/{tokenId} {
      allow create, update: if isYazabilir() && request.resource.data.uid == request.auth.uid;
      allow delete: if isLoggedIn() && resource.data.uid == request.auth.uid;
    }
    // Vekil ders onay gecmisi. Sadece sunucu yazar (vekilDersOlusturuldu /
    // vekilDersSilindi). Yonetim tum gecmisi, ogretmen kendi gecmisini okur.
    match /vekil_ders_gecmis/{docId} {
      allow read: if isYonetimOkur() ||
        (isOgretmen() && resource.data.vekil_uid == request.auth.uid);
      allow write: if false;
    }
    // Haftalik nobet gorevlendirme yazisi arsivi (nobet2.html + nobet2HaftaGuncelle).
    match /nobet2_gorevlendirmeler/{hafta} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    // Para toplama listeleri (admin). Yonetim yazar, salt-okunur idareci gorur,
    // ogretmenler erisemez.
    match /para_toplamalar/{docId} {
      allow read: if isYonetimOkur();
      allow write: if isYonetim();
    }
    match /para_odemeler/{docId} {
      allow read: if isYonetimOkur();
      allow write: if isYonetim();
    }
    // Admin "Bildirim Gonder" arsivi. Sadece sunucu (idareMesajiGonder) yazar.
    match /idare_mesajlari/{docId} {
      allow read: if isYonetimOkur();
      allow write: if false;
    }
    match /vekalet_gorulme/{docId} {
      allow read, write: if isLoggedIn();
    }
  }

}
