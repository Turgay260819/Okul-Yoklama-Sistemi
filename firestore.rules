rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol;
    }

    function isAdmin() {
      return getRole() == 'admin';
    }

    function isMudurYardimcisi() {
      return getRole() == 'mudur_yardimcisi';
    }

    function isOgretmen() {
      return getRole() == 'ogretmen';
    }

    function isOgrenci() {
      return getRole() == 'ogrenci';
    }

    function isYonetim() {
      return isAdmin() || isMudurYardimcisi();
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }

    match /students/{studentId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }

    match /teachers/{teacherId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }

    match /schedule/{scheduleId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }

    match /today_lessons/{lessonId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn();
    }

    match /attendance/{attendanceId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isYonetim();
      allow delete: if isYonetim() || isOgretmen();
    }

    match /daily_summary/{summaryId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }

    match /late_entries/{entryId} {
      allow read: if isYonetim();
      allow write: if isLoggedIn();
    }

    match /notification_queue/{notifId} {
      allow read: if isYonetim();
      allow write: if isYonetim();
    }

    match /dyk_courses/{courseId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }

    match /dyk_attendance/{attendanceId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isYonetim();
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    match /system_logs/{logId} {
      allow read: if isYonetim();
      allow write: if isLoggedIn();
    }

    match /attendance_archive/{docId} {
      allow read: if isYonetim();
      allow write: if isAdmin();
    }
   
    match /disiplin_kayitlar/{docId} {
      allow read: if isYonetim() || isOgretmen();
      allow create: if isYonetim() || isOgretmen();
      allow update, delete: if isYonetim();
    }
    match /izinler/{docId} {
      allow read: if isYonetim() || isOgretmen();
      allow create: if isYonetim() || isOgretmen();
      allow update: if isYonetim() ||
        (isOgretmen() && resource.data.rehber_id != null &&
         get(/databases/$(database)/documents/teachers/$(resource.data.rehber_id)).data.uid == request.auth.uid);
      allow delete: if isYonetim();
    }
    match /disiplin_turleri/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /disiplin_ayarlar/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /gorevler/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /ogretmen_sirasi/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /oncelik_kuyrugu/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /takvim_kilidi/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /kazanim_dersler/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /kazanim_listesi/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /kazanim_takvim/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /kazanim_tatil/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /tatil_donemleri/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /ders_saatleri/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /ogretmen_devam/{docId} {
      allow read: if isYonetim();
      allow write: if isYonetim();
    }
    match /nobet2_ayarlar/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /nobet_bildirim_alicilari/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /program_talebi_dersler/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /program_talebi_matris/{docId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn();
    }
    match /program_talebi_ayarlar/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /program_talep_tanimlar/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /program_talep_sube_toplam/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /program_talep_matris/{docId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn();
    }
    match /program_talep_ayarlar/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /anketler/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /anket_yanitlar/{docId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn();
    }
    match /anket_sablonlar/{docId} {
      allow read, write: if isYonetim();
    }
    match /ogrenci_veriler/{docId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn();
    }
    match /ogrenci_yetenekler/{docId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn();
    }
    match /geziler/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /gezi_katilim/{docId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isLoggedIn();
      allow delete: if isYonetim();
    }
    match /gezi_koltuk/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /gezi_katilacaklar/{docId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isLoggedIn();
      allow delete: if isYonetim() || (isLoggedIn() && request.auth.uid == resource.data.kullanici_id);
    }
    match /bildirimler/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /ogretmen_rapor/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /ders_listesi/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /kura_torbalari/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /kura_oturumlari/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /kura_cekilisleri/{docId} {
      allow read: if isLoggedIn();
      allow write: if isYonetim();
    }
    match /nobet_gorulme/{docId} {
      allow read, write: if isLoggedIn();
    }
    match /vekalet_gorulme/{docId} {
      allow read, write: if isLoggedIn();
    }
  }

}
